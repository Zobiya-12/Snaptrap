# ═══════════════════════════════════════════════════════════════
#  SNAPTRAP — single-service image (React build + Flask API)
#  Build context = repo ROOT.  Used by Render (free web service).
#  Local/compose setups keep using backend/Dockerfile.
# ═══════════════════════════════════════════════════════════════

# ── Stage 1: build the React app ───────────────────────────────
FROM node:20-slim AS web
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY public ./public
COPY src ./src
# Same origin as the API, so a relative URL works; CI=false so warnings don't fail the build
ENV CI=false REACT_APP_API_URL=/api
RUN CI=false npm run build

# ── Stage 2: Flask API + built frontend ────────────────────────
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ .
COPY --from=web /web/build ./web
RUN mkdir -p /app/models /app/data && chmod +x entrypoint.sh entrypoint-honeypot.sh
ENV PYTHONUNBUFFERED=1 FLASK_PORT=5000 ML_WORKERS=1
EXPOSE 5000
ENTRYPOINT ["./entrypoint.sh"]
